# Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=
# Signs superadmin sessions and encrypts device secrets at rest. Do not change after devices exist.
SECRET_KEY=
# Domain whose subdomains the devices use: <device_id>.ROOT_DOMAIN and <device_id>.local.ROOT_DOMAIN
ROOT_DOMAIN=domainutama.com
# Public URL of this control plane, written into every device.json
CONTROL_PLANE_URL=https://control.domainutama.com
LICENSE_TTL_DAYS=14
CP_PORT=8100
DISPLAY_TZ=Asia/Jakarta
# Shown next to prices in the superadmin panel.
CURRENCY=SGD
# Back up the appdata volume: it holds the license signing key (license_ed25519.pem).

# Office-network names (https://<site-id>.lan.<ROOT_DOMAIN>) with Let's Encrypt certificates.
# Cloudflare API token limited to Zone > DNS > Edit on this zone, and the zone's ID.
CF_API_TOKEN=
CF_ZONE_ID=
# Internet access (a public name per device through a Cloudflare Tunnel) also needs
# Account > Cloudflare Tunnel > Edit on the same token. The account ID is looked up from the zone
# when left empty.
CF_ACCOUNT_ID=
# Let's Encrypt account email; LE_STAGING=1 issues untrusted test certificates first.
LE_EMAIL=
LE_STAGING=1

# Media relay for meeting guests outside the office (internet access). Run it with
#   docker compose --profile turn up -d
# and open UDP+TCP 3478 and UDP 49160-49359 in the server's firewall. TURN_HOST (default
# turn.<ROOT_DOMAIN>) needs a DNS-only A record to TURN_PUBLIC_IP. Empty TURN_SECRET: no relay.
TURN_SECRET=
TURN_HOST=
TURN_PUBLIC_IP=
TURN_PRIVATE_IP=
# TURN over TLS on port 443 (for networks that only allow HTTPS): a DNS-only A record to
# TURN_PUBLIC_IP, e.g. turn.<ROOT_DOMAIN>. Its certificate comes from the certs worker; open TCP 443.
TURN_TLS_HOST=
