[Unit]
Description=Vipcon network setup (Wi-Fi hotspot + setup page when offline)
After=NetworkManager.service docker.service
Wants=NetworkManager.service
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/python3 /opt/appliance/netsetup/netsetup.py
Restart=always
RestartSec=3
RuntimeDirectory=vipcon-netsetup
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
